# ZUR environment reference. Every variable below is actually read by the code
# (grep process.env in packages/**). Copy to .env for local use; production values live in
# deploy/env.production.example. Database is SQLite only (node:sqlite); there is no Postgres adapter.
# Format: VAR=default   # required-in-prod? secret? note

NODE_ENV=development            # set "production" in prod; enables strict startup checks and Postmark default
PORT=3001                       # server listen port
DATABASE_URL=data/zur.sqlite    # prod: required, absolute SQLite file path (not a URL). Worker uses the same file.
DELETION_REGISTRY_PATH=         # prod: REQUIRED, absolute path on a separate backed-up volume, e.g. /var/lib/zur-deletions/tombstones.jsonl

APP_BASE_URL=http://localhost:5173   # prod: required for links in emails (public https origin)
MCP_ALLOWED_HOSTS=                   # prod: required, comma-separated public hostnames allowed on /mcp

EMAIL_PROVIDER=                 # "postmark" (default when NODE_ENV is production/staging) or "mock"
POSTMARK_SERVER_TOKEN=          # SECRET, required for real email
EMAIL_FROM=                     # required for real email, e.g. ZUR <no-reply@example.com>

ZUR_API_PROXY_TARGET=http://localhost:3001   # dev only: Vite proxies /api here
