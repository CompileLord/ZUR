# Environment Configuration Template for ZUR

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Authoritative Relational Database (SQLite for local dev & testing, Postgres for staging/prod)
DATABASE_URL=data/zur.sqlite
# Must point to a separately backed-up, append-only volume; provision an empty file before first startup.
DELETION_REGISTRY_PATH=/var/lib/zur-deletions/tombstones.jsonl

# Security & Sessions
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object Storage / Local Media Adapter
MEDIA_STORAGE_PATH=data/media
MAX_IMAGE_UPLOAD_BYTES=10485760

# Execution Boundary
EXECUTION_PYTHON_PATH=python
DEFAULT_CPU_TIMEOUT_SECONDS=2
DEFAULT_WALL_TIMEOUT_SECONDS=5
DEFAULT_MEMORY_LIMIT_MIB=128

# MCP Streamable HTTP Endpoint
MCP_ENDPOINT_URL=http://localhost:3000/mcp
