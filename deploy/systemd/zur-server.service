[Unit]
Description=ZUR API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zur
Group=zur
WorkingDirectory=/srv/zur
EnvironmentFile=/etc/zur/zur.env
ExecStart=/usr/bin/node --experimental-strip-types --no-warnings packages/server/src/index.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/srv/zur/data /var/lib/zur-deletions

[Install]
WantedBy=multi-user.target
