# /etc/zur/zur.env  (chmod 640, owner root:zur). Production values; replace every CHANGE_ME.
# Read by zur-server, zur-worker and zur-backup via EnvironmentFile=. No quotes.

NODE_ENV=production
PORT=3001
# Absolute path; the data dir must be writable by user zur (WorkingDirectory is /srv/zur, uploads go to /srv/zur/data/uploads).
DATABASE_URL=/srv/zur/data/zur.sqlite
# Independent, separately backed-up, append-only volume. Required in production (server refuses to boot without it).
DELETION_REGISTRY_PATH=/var/lib/zur-deletions/tombstones.jsonl

# Public origin, used in emails and MCP host checks.
APP_BASE_URL=https://learn.example.com
MCP_ALLOWED_HOSTS=learn.example.com

# Email (Postmark). With NODE_ENV=production the provider defaults to postmark.
EMAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=CHANGE_ME
EMAIL_FROM=ZUR <no-reply@learn.example.com>

# Hardening env that the server hardening task introduces (names to be confirmed against packages/server/src once merged):
# trusted reverse proxy / Secure cookies. See docs/DEPLOYMENT.md "Server requirements".

# Backup (read by deploy/backup.sh)
ZUR_BACKUP_DIR=/var/backups/zur
ZUR_BACKUP_RETENTION_DAYS=14
# ZUR_BACKUP_REMOTE_CMD=rclone copy "$1" remote:zur-backups
