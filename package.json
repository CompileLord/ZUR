{
  "name": "zur-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ZUR coding-first interactive Python learning platform",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck:shared && npm run typecheck:worker && npm run typecheck:server && npm run typecheck:web",
    "typecheck:shared": "tsc --noEmit -p packages/shared",
    "typecheck:worker": "tsc --noEmit -p packages/worker",
    "typecheck:server": "tsc --noEmit -p packages/server",
    "typecheck:web": "tsc --noEmit -p packages/web",
    "start:server": "node --experimental-strip-types --no-warnings packages/server/src/index.ts",
    "start:worker": "node --experimental-strip-types --no-warnings packages/worker/src/daemon.ts",
    "ci": "npm run check:file-size && npm run typecheck && npm test && npm run build",
    "build": "npm run build --workspaces --if-present",
    "test": "node --experimental-strip-types --test packages/shared/tests/*.test.ts packages/server/tests/*.test.ts packages/worker/tests/*.test.ts packages/web/tests/*.test.ts",
    "db:migrate": "node --experimental-strip-types packages/server/src/db/migrate.ts",
    "db:seed": "node --experimental-strip-types packages/server/src/db/seed.ts",
    "db:seed-demo": "node --experimental-strip-types --no-warnings packages/server/src/db/seed-demo.ts",
    "db:demo-users": "node --experimental-strip-types packages/server/src/db/create-demo-users.ts",
    "db:reapply-deletions": "node --experimental-strip-types packages/server/src/db/reapply-deletions.ts",
    "dev:server": "node --experimental-strip-types packages/server/src/index.ts",
    "dev:worker": "node --experimental-strip-types packages/worker/src/daemon.ts",
    "runner:prepare": "podman pull docker.io/library/python@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d",
    "dev:web": "npm run dev --workspace=packages/web",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:file-size": "node tools/check-file-size.mjs --all"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
